# WordPress Bulk Editor - Configuration Example
# Copy this file to .env and fill in your values

# ========================================
# WordPress API Credentials (REQUIRED)
# ========================================
# Все команды используют credentials из .env файла
# Основные команды (sync, fetch, export, export-media, bulk-delete) также
# принимают явные CLI параметры --domain, --username, --password для максимальной гибкости

WP_DOMAIN=https://example.com
WP_API_USER=admin
WP_API_TOKEN=xxxx xxxx xxxx xxxx

# ========================================
# Sync Configuration
# ========================================

# Maximum number of parallel HTTP requests
SYNC_CONCURRENCY=5

# Number of rows to process in one batch
SYNC_BATCH_SIZE=10

# HTTP request timeout in seconds
SYNC_TIMEOUT=30

# Maximum retry attempts for failed requests
SYNC_MAX_RETRIES=3

# ========================================
# Logging Configuration
# ========================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file rotation size (e.g., 10 MB, 100 MB)
LOG_ROTATION=10 MB

# Log retention period (e.g., 7 days, 30 days, 1 week)
LOG_RETENTION=30 days

# ========================================
# Media Upload Configuration
# ========================================

# Maximum file size for media uploads in MB
MEDIA_MAX_SIZE_MB=10

# Allowed media file extensions (comma-separated)
MEDIA_ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp,pdf,doc,docx

# ========================================
# Paths Configuration
# ========================================

# Base path for media files (relative to project root)
MEDIA_BASE_PATH=data/media

# Logs folder path
LOGS_FOLDER=logs

# ========================================
# Security
# ========================================

# Verify SSL certificates (set to false only for development)
VERIFY_SSL=true

# ========================================
# Google Sheets Integration
# ========================================

# Google Sheets document ID (from the URL)
# Example: https://docs.google.com/spreadsheets/d/1B5gj1nxzVhQ-9nk1o_KVgtwRyj_gl4yibIXmG4zZUq4/edit
# GOOGLE_SHEET_ID=1B5gj1nxzVhQ-9nk1o_KVgtwRyj_gl4yibIXmG4zZUq4

# Path to Google Service Account credentials JSON file
# GOOGLE_SHEET_CREDENTIALS_PATH=credentials/google_sheets_credentials.json
