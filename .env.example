# WordPress Bulk Editor - Configuration Example
# Copy this file to .env and fill in your values

# ========================================
# WordPress API Credentials (REQUIRED)
# ========================================
# Все команды используют credentials из .env файла
# Основные команды (sync, fetch, export, export-media, bulk-delete) также
# принимают явные CLI параметры --domain, --username, --password для максимальной гибкости

WP_DOMAIN=https://example.com
WP_API_USER=admin
WP_API_TOKEN=xxxx xxxx xxxx xxxx

# ========================================
# Sync Configuration
# ========================================

# Maximum number of parallel HTTP requests
SYNC_CONCURRENCY=5

# Number of rows to process in one batch
SYNC_BATCH_SIZE=10

# HTTP request timeout in seconds
SYNC_TIMEOUT=30

# Maximum retry attempts for failed requests
SYNC_MAX_RETRIES=3

# ========================================
# Logging Configuration
# ========================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file rotation size (e.g., 10 MB, 100 MB)
LOG_ROTATION=10 MB

# Log retention period (e.g., 7 days, 30 days, 1 week)
LOG_RETENTION=30 days

# ========================================
# Media Upload Configuration
# ========================================

# Maximum file size for media uploads in MB
MEDIA_MAX_SIZE_MB=10

# Allowed media file extensions (comma-separated)
MEDIA_ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp,pdf,doc,docx

# ========================================
# Paths Configuration
# ========================================

# Base path for media files (relative to project root)
MEDIA_BASE_PATH=data/media

# Logs folder path
LOGS_FOLDER=logs

# ========================================
# Security
# ========================================

# Verify SSL certificates (set to false only for development)
VERIFY_SSL=true

# ========================================
# Discovery Filters
# ========================================
# Паттерны для пропуска служебных типов записей (через запятую)
# Типы, содержащие эти подстроки, будут пропущены при fetch --auto
WP_SKIP_POST_TYPE_PATTERNS=wp_,attachment,nav_menu,spectra,revision

# Паттерны для пропуска служебных таксономий (через запятую)
WP_SKIP_TAXONOMY_PATTERNS=nav_menu,link_category,post_format

# ========================================
# Async Sync Configuration (NEW)
# ========================================
# Параметры для асинхронных команд: async, async-from-google, async-google-bidirectional
# Обеспечивают параллельную обработку строк, retry и circuit breaker для устойчивости

# Maximum number of parallel API requests (default: 5)
# Рекомендуемые значения: 5-20 для стабильных серверов, 3-5 для медленных
WP_SYNC_CONCURRENCY=5

# API request timeout in seconds (default: 30)
WP_API_TIMEOUT=30

# Media upload timeout in seconds (default: 120)
# Увеличьте для больших медиафайлов
WP_MEDIA_TIMEOUT=120

# Maximum retry attempts for failed requests (default: 3)
# Retry применяется только для: 5xx, 429, timeout, network errors
# НЕ применяется для: 401, 404, 400
WP_MAX_RETRIES=3

# Initial retry delay in seconds (default: 1)
# Используется exponential backoff: delay = base * (2 ^ attempt)
WP_RETRY_DELAY=1

# Circuit breaker failure threshold (default: 10)
# После N последовательных ошибок circuit breaker открывается и блокирует запросы
WP_CIRCUIT_BREAKER_THRESHOLD=10

# Circuit breaker recovery timeout in seconds (default: 60)
# Время ожидания перед попыткой восстановления
WP_CIRCUIT_BREAKER_RECOVERY=60

# ========================================
# Google Sheets Integration
# ========================================

# Google Sheets document ID (from the URL)
# Example: https://docs.google.com/spreadsheets/d/1B5gj1nxzVhQ-9nk1o_KVgtwRyj_gl4yibIXmG4zZUq4/edit
# GOOGLE_SHEET_ID=1B5gj1nxzVhQ-9nk1o_KVgtwRyj_gl4yibIXmG4zZUq4

# Path to Google Service Account credentials JSON file
# GOOGLE_SHEET_CREDENTIALS_PATH=credentials/google_sheets_credentials.json

# ========================================
# LLM Configuration (for llm command)
# ========================================

# LLM API endpoint (OpenAI-compatible)
# Example: http://localhost:8317/v1/chat/completions
LLM_ENDPOINT=http://localhost:8317/v1/chat/completions

# LLM API token/key
LLM_TOKEN=your-api-key-here

# Default models for generation (comma-separated, with fallback)
# Text generation models:
#   Example: "gemini-2.5-flash-lite,gpt-4,claude-3"
# Image generation models:
#   Example: "gemini-3-pro-image-preview,or/gemini-pro-image,or/gemini-flash-image"
# If not set, --model parameter becomes required
LLM_MODELS=gemini-2.5-flash-lite

# Default prompt template (can use [column_name] placeholders)
# Text examples:
#   "Напиши короткий lead абзац к услуге [title]"
#   "Создай мета-описание для [title]. Только текст, 120-155 символов."
# Image examples (with aspect ratio for photorealistic results):
#   "A photorealistic image of [title], aspect ratio 16:9, professional lighting"
#   "Photorealistic [title], 4:3 aspect ratio, golden hour, ultra detailed"
LLM_PROMPT=Напиши текст для [title]
